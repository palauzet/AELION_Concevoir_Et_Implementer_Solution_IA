# Copier en .env et adapter si besoin.
# La connexion vise l'instance PostgreSQL du conteneur Docker fourni
# (docker/pgdocker). Les valeurs par défaut (cf. src/indusense/config.py)
# reprennent celles du docker-compose ; surcharger ici au besoin :
# INDUSENSE_PG_HOST=localhost
# INDUSENSE_PG_PORT=5432
# INDUSENSE_PG_DATABASE=indusense_db
# INDUSENSE_PG_USER=indusense_user
# INDUSENSE_PG_PASSWORD=ThEP@ssW0rd
#
# Ou forcer une URL SQLAlchemy complète (prioritaire sur les variables ci-dessus) :
# INDUSENSE_DB_URL=postgresql+psycopg://user:password@host:5432/dbname
