# Copier en .env et adapter si besoin.
# Par défaut, la connexion vise SQL Server en authentification Windows
# (cf. src/indusense/config.py). Surcharger éventuellement ces variables :
# INDUSENSE_SQL_SERVER=XANADU-PC03
# INDUSENSE_SQL_DATABASE=AELION_SPRINT01
# INDUSENSE_ODBC_DRIVER=ODBC Driver 17 for SQL Server
#
# Ou forcer une URL SQLAlchemy complète (prioritaire sur les variables ci-dessus) :
# INDUSENSE_DB_URL=mssql+pyodbc://...
